# systemd --user template unit -- one instance per workflow.
#
# Install:   ~/.config/systemd/user/rocoto-workflow@.service
# Env file:  ~/.config/rocoto-systemd/<instance>.env   (WF=, DB=, WD=, ...)
# Scripts:   ~/rocoto-systemd/{loop.sh,node-guard.sh,common.sh}   (see install.sh)
#
# Run once, no scheduler:   systemctl --user start        rocoto-workflow@<instance>
# Survive reboots:          systemctl --user enable --now rocoto-workflow@<instance>
#                           (loop.sh `disable`s it again once the workflow finishes)
#
# ANY unattended use REQUIRES user lingering:
#     loginctl enable-linger <user>

[Unit]
Description=Rocoto workflow driver (%i)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=%h/.config/rocoto-systemd/%i.env
WorkingDirectory=%h
# Skip the start on the wrong node when the instance is pinned (PIN_NODE in the
# env file).  ExecCondition (systemd >= 243), not ExecStartPre: a guard exit of
# 1-254 leaves the unit inactive -- not failed, never restarted -- which is what
# the other nodes sharing this $HOME should do at boot.  Older systemd ignores
# the line with a warning; loop.sh's own pin check still refuses (exit 78).
ExecCondition=%h/rocoto-systemd/node-guard.sh
ExecStart=%h/rocoto-systemd/loop.sh

# Clean exit (workflow settled) => stays stopped.  Only a crash restarts it.
Restart=on-failure
RestartSec=60
# loop.sh exits 78 on bad config (or, as the backstop, a wrong node): do not
# retry-loop that.  This only covers the main process -- it has no effect on
# ExecCondition/ExecStartPre, which is why the node guard is an ExecCondition.
RestartPreventExitStatus=78

# --- the service's own append-only log -------------------------------------
# StandardOutput=append: needs systemd >= v240.  Check `systemctl --version`.
# If older: change both to `journal` -- loop.sh will append to the same file itself.
StandardOutput=append:%h/rocoto-systemd/logs/%i.service.log
StandardError=append:%h/rocoto-systemd/logs/%i.service.log
SyslogIdentifier=rocoto-%i

# --- resource backstops --------------------------------------------------
MemoryAccounting=yes
MemoryHigh=1G
MemoryMax=2G
TasksAccounting=yes
TasksMax=256
# Optional HARD wall-clock cap (systemd SIGKILLs the service).  Left off so long
# realtime workflows are not killed; loop.sh's MAX_RUNTIME is the soft equivalent.
# Enable per install with:  systemctl --user edit rocoto-workflow@<instance>
#   [Service]
#   RuntimeMaxSec=604800

[Install]
WantedBy=default.target
