# `new-workflow.sh` writes ~/.config/rocoto-systemd/<instance>.env for you.
# This is the annotated reference; copy + edit it only if you set one up by hand.
# <instance> is any short nickname (e.g. rrfsdet).
#
# If you also run the optional scron watchdog, watchdog.sh REWRITES this file on
# every tick from its `#SCRON --export=` list -- so for that path edit the export
# list in the .scrontab, not this file.

# --- required ---
WF=/gpfs/f6/arfs-gsl/world-shared/gge/rrfs2/regressionTests/conus12km/exp/rrfsdet/rrfs.xml
DB=/gpfs/f6/arfs-gsl/world-shared/gge/rrfs2/regressionTests/conus12km/exp/rrfsdet/rrfs.db
WD=/gpfs/f6/arfs-gsl/world-shared/gge/rrfs2/regressionTests/conus12km/exp/rrfsdet

# --- rocoto discovery (pick modules OR ROCOTO_BIN) ---
ROCOTO_MODULEPATH=/gpfs/f6/arfs-gsl/world-shared/gge/rocoto/modulefiles
ROCOTO_MODULE=rocoto/1.3.7g
# ROCOTO_BIN=/gpfs/f6/arfs-gsl/world-shared/gge/rocoto/bin

# --- node isolation (optional) ---
# If set, loop.sh / node-guard.sh refuse to run anywhere except this node, and
# new-workflow.sh writes a matching '#SCRON --nodelist=' into the scrontab entry.
# Needed on Gaea when the cron partition has more than one node (each node has its
# own systemd --user manager and they cannot talk to each other).
# PIN_NODE=gaea61

# --- behaviour (all optional; defaults shown) ---
VERBOSITY=10
INTERVAL=300
IDLE_LIMIT=3
MAX_RUNTIME=259200
MEM_SAMPLE_INTERVAL=3
